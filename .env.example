# Copy to backend/.env and fill in. Never commit the filled file.
#
# Every setting in backend/src/strategy_manager/shared/config.py appears below,
# in that file's order. Anything left out falls back to the default shown, so
# a minimal deployment only has to set the four that have no safe default:
# DATABASE_URL, WEBHOOK_SECRET, MASTER_ENCRYPTION_KEY, and — in live mode —
# BINANCE_API_KEY / BINANCE_API_SECRET.
#
# TRADING KEYS DO NOT LIVE HERE. Every key in this file is READ-ONLY. The keys
# that sign orders are envelope-encrypted in the database vault and are
# decrypted only in the worker at signing time (CLAUDE.md rule 8). Seal them
# with the scripts/ storage helpers; never paste one into this file.
#
# List values are parsed as JSON, because pydantic-settings reads complex
# types that way: EXTRA_WEBHOOK_SOURCE_IPS=["127.0.0.1"], not a bare address.

# --- Database -----------------------------------------------------------
# Local PostgreSQL 17 service (already installed on this machine). The test
# suite derives strategy_manager_test from this URL and refuses to run if the
# two match, so this must point at the DEV database.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/strategy_manager

# --- Safety -------------------------------------------------------------
# When true, no order is ever sent to a real exchange: the fake adapters are
# registered instead and the worker never reads the credential vault. Setting
# it to false requires a live adapter to be registered — the worker refuses to
# start otherwise, rather than reporting fabricated fills.
DRY_RUN=true

# --- TradingView webhook ------------------------------------------------
# Shared secret embedded in the alert JSON payload. TradingView cannot sign
# its requests, so this plus the source-IP allowlist is the whole auth story.
# The API refuses to start with this empty: an empty secret makes the
# comparison vacuous, so every alert would be answered 401 and lost silently.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Extra source addresses the webhook accepts ON TOP of TradingView's four.
# Empty by default; it exists because the ingress path cannot be rehearsed
# otherwise — an alert has to come from one of four fixed addresses.
#
# WIDENING THIS IS WIDENING AUTHENTICATION. The shared secret is still
# required, but every address here is one more place a request carrying a
# leaked secret is accepted from. Add a loopback to rehearse locally; never
# add a proxy's address to "make the tunnel work" — every request through a
# proxy carries that address, so the allowlist would then constrain nothing.
# A tunnel is what BEHIND_CLOUDFLARE_TUNNEL is for.
# EXTRA_WEBHOOK_SOURCE_IPS=["127.0.0.1"]

# Whether this deployment sits behind a Cloudflare Tunnel. Turning it on means
# CF-Connecting-IP is TRUSTED as the client's address.
#
# A DEPLOYMENT DECLARATION, never an autodetection. It is correct only when
# the tunnel is genuinely the sole route to the origin, because Cloudflare
# overwrites that header only on what it forwards — anything that can reach
# the port another way can send a header of its own. Leave it false when the
# origin is reachable directly.
BEHIND_CLOUDFLARE_TUNNEL=false

# --- Credential encryption ---------------------------------------------
# 32 random bytes, base64-encoded. The master key that wraps every stored
# exchange credential.
#
# IT CANNOT BE REGENERATED once credentials are sealed. A different key makes
# every stored credential permanently unreadable — there is no recovery, only
# re-sealing every key by hand. Back it up where the database backup is not.
# The worker opens every sealed credential at startup and refuses to run if
# this key does not match them, so a mismatch surfaces at deploy time.
# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=

# --- Pionex -------------------------------------------------------------
# Spot lives under /api/v1/ and futures under /uapi/v1/ on this one host.
# Change only to point at a mirror.
# PIONEX_BASE_URL=https://api.pionex.com

# Read-only Pionex credentials, used by probes and the balance reader. Pionex
# is not registered as a live venue (it offers no futures order placement over
# the API), so these are optional and unused in normal operation.
# PIONEX_API_KEY=
# PIONEX_API_SECRET=

# Pionex rejects a timestamp more than 20s off its clock, so a read that
# outlives that window can never succeed on retry anyway.
# PIONEX_TIMEOUT_SECONDS=10.0

# --- Bybit --------------------------------------------------------------
# Point at api-testnet.bybit.com to rehearse against Bybit's real testnet.
# BYBIT_BASE_URL=https://api.bybit.com

# Read-only Bybit credentials, for probes and scripts. Bybit's balance sync
# reads the VAULT credential, not these, so leaving them empty does not break
# live operation.
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# BYBIT_TIMEOUT_SECONDS=10.0

# Bybit rejects a timestamp outside this window against its own clock. 5000ms
# is Bybit's default, generous enough that clock skew — not latency — is what
# would break it. Raise it only if the host's clock genuinely drifts.
# BYBIT_RECV_WINDOW_MS=5000

# --- Binance ------------------------------------------------------------
# Two hosts, one signing scheme: USDⓈ-M futures on fapi, spot and the
# account-wide wallet endpoints on api.
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BINANCE_SPOT_BASE_URL=https://api.binance.com

# The READ-ONLY Binance key — and it is LOAD-BEARING in live mode. Unlike
# Bybit, Binance's balance.sync job signs with THIS environment key rather
# than with the vault credential, because the trade key is IP-restricted and a
# balance read must keep working from any host. Leave it unset with DRY_RUN
# false and balance sync fails, which starves the allocation engine of the
# snapshot it sizes trades against.
#
# The converse trap: a green balance sync says nothing about whether this host
# can trade. The vault's trade key is exercised only at order time.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# BINANCE_TIMEOUT_SECONDS=10.0

# Binance rejects a timestamp 1000ms or more ahead of its clock, or older than
# this window. 5000ms is Binance's default; 60000ms its ceiling.
# BINANCE_RECV_WINDOW_MS=5000

# --- API ----------------------------------------------------------------
# Browser origins allowed to call this API. The default is the Vite dev server
# and is DEV-ONLY: a real deployment must name its own frontend origin, since
# credentials are allowed on CORS requests.
# CORS_ORIGINS=["http://localhost:5173"]

# --- Allocation and worker timings --------------------------------------
# How long a PENDING/SUBMITTED reservation counts against pool availability
# before it is excluded and swept. Too high strands capital after a crash; too
# low releases capital an order is still using.
# RESERVATION_TTL_SECONDS=30

# How long the worker sleeps between polls when it finds no claimable job.
# Lower means faster signal pickup and more idle database queries.
# WORKER_POLL_INTERVAL_SECONDS=2.0

# How long execution.settle waits before asking the exchange what an order
# became. Long enough that a market order has normally been published, short
# enough that a reservation is not left in limbo — and the job retries anyway
# when the fills are not there yet.
# EXECUTION_SETTLE_DELAY_SECONDS=2.0

# How often balance.sync refreshes pool_balance_snapshots. This is the whole
# rate at which the system learns its own capital changed.
# BALANCE_SYNC_INTERVAL_SECONDS=15.0

# How old a snapshot may be before allocation refuses to size a trade against
# it. Generous relative to the sync interval on purpose: a couple of transient
# API failures must not halt trading, but a sync chain that actually died must.
# BALANCE_SNAPSHOT_MAX_AGE_SECONDS=90.0
