# Copy to backend/.env and fill in. Never commit the filled file.

# --- Database -----------------------------------------------------------
# Local PostgreSQL 17 service (already installed on this machine).
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/strategy_manager

# --- Safety -------------------------------------------------------------
# When true, no order is ever sent to a real exchange. Keep it true until
# the allocation engine has been verified end to end.
DRY_RUN=true

# --- TradingView webhook ------------------------------------------------
# Shared secret embedded in the alert JSON payload. TradingView cannot sign
# its requests, so this plus the source-IP allowlist is the whole auth story.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- Credential encryption ---------------------------------------------
# 32 random bytes, base64-encoded. Encrypts Pionex API keys at rest.
# Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=
